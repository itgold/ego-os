---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getBookPart } from '../../data/bookParts';
import BookNavigation from '../../components/BookNavigation.astro';
import BookHeader from '../../components/BookHeader.astro';

const part = getBookPart('introduction');
if (!part) throw new Error('Missing introduction section in book structure.');

const introduction = (await getCollection('chapters', ({ data }) => !data.draft))
  .find(({ slug }) => slug === part.contentSlug);

if (!introduction) {
  throw new Error('The Introduction part content could not be found.');
}

const { Content } = await introduction.render();
---

<BaseLayout
  title={`${part.number} — ${part.title} — Ego OS`}
  description={introduction.data.description}
>
  <BookHeader currentChapter={`Section ${part.number}`} />
  <main id="main-content" class="chapter part-page">
    <header class="chapter__header">
      <p class="eyebrow">Section {part.number}</p>
      <h1>{part.title}</h1>
      <p class="chapter__description">{introduction.data.description}</p>
    </header>
    <article class="chapter__content">
      <Content />
    </article>
    <BookNavigation partId={part.id} />
  </main>
</BaseLayout>
