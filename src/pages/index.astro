---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/home/Header.astro';
import EgoTitle from '../components/home/EgoTitle.astro';
import LayersStack from '../components/home/LayersStack.astro';
import '../styles/homepage.css';
---

<BaseLayout title="Ego OS — An illustrated model of the mind" description="An interactive illustrated book about the systems that make us who we are.">
  <div class="homepage-shell">
    <Header />
    <main id="main-content" class="homepage-main">
      <EgoTitle />
      <LayersStack />
    </main>
    <p class="edition-mark" aria-hidden="true">A field guide to the architecture of self · 2026</p>
  </div>
</BaseLayout>
