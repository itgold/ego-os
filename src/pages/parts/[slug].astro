---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BookHeader from '../../components/BookHeader.astro';
import { bookParts } from '../../data/bookParts';

export function getStaticPaths() {
  return bookParts.map((part) => ({
    params: { slug: part.href.split('/').filter(Boolean).at(-1) },
    props: { part },
  }));
}

const { part } = Astro.props;
---

<BaseLayout title={`${part.number} — ${part.title} — Ego OS`} description={`Explore ${part.title}, ${part.number} of Ego OS.`}>
  <BookHeader currentChapter={part.number} />
  <main id="main-content" class="part-overview">
    <a class="part-overview__back" href="/#parts">← All five parts</a>
    <p class="eyebrow">{part.number}</p>
    <h1>{part.title}</h1>
    <p class="part-overview__intro">The chapters in this part will be published here as the book develops.</p>
    <ol>
      {part.chapters.map((chapter, index) => (
        <li><span>{String(index + 1).padStart(2, '0')}</span><h2>{chapter}</h2></li>
      ))}
    </ol>
  </main>
</BaseLayout>
