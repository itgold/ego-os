---
import { homepage } from '../../data/homepage';
import { homepageLayers, getPartPresentation } from '../../presentation/homepage';
import { bookParts } from '../../data/bookParts';
import { getCollection } from 'astro:content';
import BookPartLayer from './layers/BookPartLayer.astro';
import Layer01Artwork from './layers/Layer01Artwork.astro';
import ActiveBookPartCopy from './layers/ActiveBookPartCopy.astro';
import { Image } from 'astro:assets';

const layerOrder = [...homepageLayers].reverse();
const partContent = await getCollection('parts');
const activeCopyByPart = new Map(partContent.map(({ data }) => [data.partId, data]));
// Fail the build if section copy is missing or references a removed section.
for (const part of bookParts) {
  if (!activeCopyByPart.has(part.id)) throw new Error(`Missing homepage copy for ${part.id}`);
}
for (const { data } of partContent) {
  if (!bookParts.some((part) => part.id === data.partId)) throw new Error(`Unknown homepage section ${data.partId}`);
}

const parts = bookParts.map((part) => {
  const marker = getPartPresentation(part.id).marker;
  const words = part.title.split(' ');
  const titleLines = marker.breakAfterWords
    ? [words.slice(0, marker.breakAfterWords).join(' '), words.slice(marker.breakAfterWords).join(' ')]
    : [part.title];
  return { ...part, titleLines, ...marker };
});
---

<section class="mind-structure" id="parts" aria-labelledby="structure-title" data-mind-structure>
  <h2 id="structure-title" class="sr-only">{homepage.labels.structure}</h2>

  <div class="mind-structure__stack">
    {layerOrder.map((part) => {
      const activeCopy = activeCopyByPart.get(part.id);
      return (
      <BookPartLayer part={part} index={homepageLayers.indexOf(part)}>
        {part.defaultLayer && (
          <>
            <Image class="part-layer__stack-texture" src="/assets/home-layers/layer-01-texture.png" width={1163} height={853} alt="" aria-hidden="true" loading="eager" />
            <Layer01Artwork />
          </>
        )}
        {activeCopy && (
          <ActiveBookPartCopy activeCopy={activeCopy} />
        )}
      </BookPartLayer>
      );
    })}
  </div>

  <ol class="chapter-markers" aria-label={homepage.labels.parts}>
    {parts.map((part) => (
      <li class="chapter-marker" style={`--chapter-y: ${part.y}; --chapter-anchor: ${part.anchor}; --chapter-line: ${part.line}px;`}>
        <a class="chapter-marker__link" href={`#${part.id}`} aria-label={`${part.number} ${part.title}`}>
          <span class="chapter-marker__dot" aria-hidden="true"></span>
          <span class="chapter-marker__line" aria-hidden="true"></span>
          <span class="chapter-marker__label">
            <span class="chapter-marker__number">{part.number}</span>
            <span class="chapter-marker__title">
              {part.titleLines.map((titleLine, lineIndex) => (
                <>{lineIndex > 0 && <br />}{titleLine}</>
              ))}
            </span>
          </span>
        </a>
      </li>
    ))}
  </ol>

  <ol class="depth-key" aria-label={homepage.labels.readingDepth}>
    {bookParts.map((part) => (
      <li aria-current={part === bookParts[0] ? 'step' : undefined}>
        <a href={part.href}><span>{`${part.number} — `}</span><span>{part.title}</span></a>
      </li>
    ))}
  </ol>
</section>

<script>
  const structure = document.querySelector<HTMLElement>('[data-mind-structure]');

  const clickStack = structure?.querySelector<HTMLElement>('.mind-structure__stack');

  // The stack DOM is static; retain its elements and image references once.
  const layers = [...(clickStack?.querySelectorAll<HTMLElement>('.part-layer[data-part]') ?? [])];
  const layerImages = new Map(layers.map((layer) => [
    layer,
    layer.querySelector<HTMLImageElement>('.part-layer__stack-texture, .part-layer__texture'),
  ]));
  const layersByDepth = new Map(layers.map((layer) => [
    Number(layer.dataset.part?.replace('part-', '')),
    layer,
  ]));
  const depthOrderedLayers = [...layersByDepth.entries()]
    .sort(([a], [b]) => a - b)
    .map(([, layer]) => layer);
  let frontToBackLayers: HTMLElement[] = [];

  // Responsive styles change z-index; read it once per layer on resize only.
  // Folding and hover classes do not change the stacking order.
  function refreshLayerOrder() {
    frontToBackLayers = layers
      .map((layer) => ({ layer, zIndex: Number.parseInt(getComputedStyle(layer).zIndex || '0') || 0 }))
      .sort((a, b) => b.zIndex - a.zIndex)
      .map(({ layer }) => layer);
  }
  refreshLayerOrder();
  window.addEventListener('resize', refreshLayerOrder);
  // Small shadow assets can load before the artwork and briefly form a black stack.
  // Decode every base texture before revealing any shadows, including lower layers.
  async function revealStackShadows() {
    const textures = layers.map((layer) => layer.querySelector<HTMLImageElement>('.part-layer__texture'));
    const ready = await Promise.all(textures.map(async (texture) => {
      if (!texture) return false;
      try {
        await texture.decode();
        return true;
      } catch {
        // Missing artwork must never leave its opaque shadow exposed.
        return false;
      }
    }));
    if (ready.length > 0 && ready.every(Boolean)) structure?.classList.add('has-decoded-textures');
  }
  void revealStackShadows();

  const clickCanvas = document.createElement('canvas');
  const clickContext = clickCanvas.getContext('2d', { willReadFrequently: true });

  interface AlphaMask {
    source: string;
    width: number;
    height: number;
    alpha: Uint8Array;
  }

  // Keep only alpha bytes; the temporary RGBA buffer can be released after extraction.
  const alphaMasks = new WeakMap<HTMLImageElement, AlphaMask>();

  function getAlphaMask(image: HTMLImageElement): AlphaMask | undefined {
    if (!clickContext || !image.complete || !image.naturalWidth || !image.naturalHeight) return;
    const source = image.currentSrc || image.src;
    const cached = alphaMasks.get(image);
    if (cached?.source === source && cached.width === image.naturalWidth && cached.height === image.naturalHeight) {
      return cached;
    }

    const width = image.naturalWidth;
    const height = image.naturalHeight;
    clickCanvas.width = width;
    clickCanvas.height = height;
    clickContext.drawImage(image, 0, 0);
    const pixels = clickContext.getImageData(0, 0, width, height).data;
    const alpha = new Uint8Array(width * height);
    for (let i = 0; i < alpha.length; i += 1) {
      alpha[i] = pixels[i * 4 + 3];
    }
    const mask = { source, width, height, alpha };
    alphaMasks.set(image, mask);
    return mask;
  }

  // Hover and clicks use the same cached silhouette with their existing thresholds.
  function hitsLayer(layer: HTMLElement, clientX: number, clientY: number, threshold: number): boolean {
    const image = layerImages.get(layer);
    if (!image) return false;
    const box = image.getBoundingClientRect();
    if (!box.width || !box.height || clientX < box.left || clientX >= box.right || clientY < box.top || clientY >= box.bottom) return false;
    const mask = getAlphaMask(image);
    if (!mask) return false;
    const x = Math.floor((clientX - box.left) * mask.width / box.width);
    const y = Math.floor((clientY - box.top) * mask.height / box.height);
    return mask.alpha[y * mask.width + x] > threshold;
  }

  // Remove fully folded layers from rendering, including their animated SVG images.
  const suspensionTimers = new Map<HTMLElement, number>();

  function suspendLayer(layer: HTMLElement) {
    const pending = suspensionTimers.get(layer);
    if (pending !== undefined) window.clearTimeout(pending);
    layer.classList.add('is-obscured');
    // Fallback for transitions that do not emit transitionend (for example in a background tab).
    suspensionTimers.set(layer, window.setTimeout(() => finishLayerSuspension(layer), 2100));
  }

  function finishLayerSuspension(layer: HTMLElement) {
    const pending = suspensionTimers.get(layer);
    if (pending !== undefined) window.clearTimeout(pending);
    suspensionTimers.delete(layer);
    if (layer.classList.contains('is-obscured')) layer.classList.add('is-suspended');
  }

  function resumeLayer(layer: HTMLElement) {
    const pending = suspensionTimers.get(layer);
    if (pending !== undefined) window.clearTimeout(pending);
    suspensionTimers.delete(layer);
    if (layer.classList.contains('is-suspended')) {
      layer.classList.remove('is-suspended');
      // Establish the transparent starting state before beginning the fade-in.
      layer.getBoundingClientRect();
    }
    layer.classList.remove('is-obscured');
  }

  layers.forEach((layer) => {
    layer.addEventListener('transitionend', (event) => {
      if (event.target === layer && event.propertyName === 'opacity' && getComputedStyle(layer).opacity === '0') {
        finishLayerSuspension(layer);
      }
    });
  });

  // Layers currently hidden by folding, restored in reverse order.
  let layersStack: HTMLElement[] = [];

  // Timer controlling the next sequential fold step.
  let stackTimer: number | undefined;

  // Generation token that invalidates stale folding callbacks.
  let stackRun = 0;

  // Generation token that invalidates stale unfolding callbacks.
  let unfoldRun = 0;

  /**
   * Folds every visible layer above a selected layer in depth order.
   * The selected layer becomes active when its immediate covering layer is hidden.
   * Called by stackFolding for artwork clicks and by selectPart when a label
   * targets a currently visible layer.
   */
  function foldToLayer(clickedDepth: number, hit: HTMLElement) {
    if (!structure) return;

    unfoldRun += 1;
    const run = ++stackRun;
    const ordered = depthOrderedLayers
      .filter((layer) => {
        const depth = Number(layer.dataset.part?.replace('part-', ''));
        const visible = getComputedStyle(layer).opacity !== '0' && !layer.classList.contains('is-obscured');
        return depth < clickedDepth && visible;
      });
    const hideNext = () => {
      // Called immediately and then once per second by the fold timer. Each
      // call handles one layer so its transition can begin before the next.
      if (run !== stackRun) return;
      const next = ordered.shift();
      if (!next) {
        // No upper layers remain; activate the clicked layer immediately.
        if (layersStack.length === 0) hit.classList.add('is-active');
      } else {
        // Persist this layer so an outside click can restore it later.
        layersStack.push(next);
        const nextDepth = Number(next.dataset.part?.replace('part-', ''));
      // The clicked layer becomes active exactly when its immediate covering
      // layer is folded away. If nothing covers it, activate it immediately.
      if (nextDepth === clickedDepth - 1) hit.classList.add('is-active');
        // The layer is now hidden and no longer active.
        next.classList.remove('is-active');
        suspendLayer(next);
        stackTimer = window.setTimeout(hideNext, 1000);
      }
    };
    hideNext();
  }

  /**
   * Navigates to a layer selected by a chapter label. Hidden targets unfold
   * until reached; visible targets use the shared folding routine.
   * Called by chapterLabelClick after a right-side label is activated.
   */
  function selectPart(targetDepth: number) {
    if (!structure) return;
    const target = layersByDepth.get(targetDepth);
    if (!target) return;

    if (target.classList.contains('is-obscured')) {
      stackUnfolding(new MouseEvent('click'), targetDepth);
    } else {
      foldToLayer(targetDepth, target);
    }
  }

  /**
   * Converts a chapter-label anchor into an in-stack layer selection without
   * allowing the browser to jump to the layer element or trigger page folding.
   * Called by click listeners registered on .chapter-marker__link elements.
   */
  function chapterLabelClick(event: MouseEvent) {
    const link = event.currentTarget as HTMLAnchorElement;
    const match = link.getAttribute('href')?.match(/^#part-(\d+)$/);
    if (!match) return;
    event.preventDefault();
    event.stopPropagation();
    selectPart(Number(match[1]));
  }

  /**
   * Finds the topmost opaque layer under a pointer click and delegates folding
   * to the shared depth-based fold routine.
   * Called by the stack click listener when artwork is clicked.
   */
  function stackFolding(event: MouseEvent) {
    if (!clickContext) return;

    const hit = frontToBackLayers.find((layer) => hitsLayer(layer, event.clientX, event.clientY, 180));
    if (!hit) return;
    // Every section card follows the canonical route once it is open.
    const destination = hit.querySelector<HTMLAnchorElement>('.part-layer__label')?.getAttribute('href');
    if (hit.classList.contains('is-active') && destination && destination !== '#') {
      window.location.assign(destination);
      return;
    }
    foldToLayer(Number(hit.dataset.part?.replace('part-', '')), hit);
  }

  /**
   * Restores hidden layers from nearest to farthest. When targetDepth is set,
   * restoration stops as soon as that specific layer becomes visible.
   * Called by the document click listener for outside clicks, or by selectPart
   * when its requested target is hidden.
   */
  function stackUnfolding(event: MouseEvent, targetDepth?: number) {
    // Unfolding cancels the current folding run, then restores queued layers
    // from nearest to farthest so the stack state changes predictably.
    // Clicks inside the stack belong to folding; only an outside click starts
    // unfolding, preventing the two state machines from fighting each other.
    if (!structure || clickStack?.contains(event.target as Node)) return;
    const run = ++unfoldRun;

    // Unfolding starts from the current active state, not the default state.
    layers.forEach((layer) => layer.classList.remove('is-active'));
    // Invalidate the active folding run so it can no longer mutate the stack.
    stackRun += 1;

    // Cancel any pending folding step before unfolding the next queued layer.
    // Invalidate both pending timers and callback generations before popping
    // anything, so an old folding loop cannot mutate the restored state.
    if (stackTimer) {
      window.clearTimeout(stackTimer);
      stackTimer = undefined;
    }
    //# Restore one queued layer at a time.
    const restoreNext = () => {
      // Called immediately and then once per second by the restore timer to
      // reveal one queued layer at a time.
      if (run !== unfoldRun) return;
      const layer = layersStack.pop();
      if (!layer) return;
      layer.classList.add('is-restoring');
      layer.classList.remove('is-active');
      resumeLayer(layer);
      window.setTimeout(() => {
      layer.classList.remove('is-restoring');
        if (targetDepth !== undefined && Number(layer.dataset.part?.replace('part-', '')) === targetDepth) {
          layer.classList.add('is-active');
          return;
        }
        restoreNext();
      }, 1000);
    };
    restoreNext();
  }

  let hoveredLayer: HTMLElement | undefined;
  let hoverFrame: number | undefined;
  let hoverPosition: { clientX: number; clientY: number } | undefined;

  // Coalesce pointer events into one hit test per frame using the latest position.
  function scheduleLayerHover(event: PointerEvent) {
    hoverPosition = { clientX: event.clientX, clientY: event.clientY };
    if (hoverFrame !== undefined) return;
    hoverFrame = window.requestAnimationFrame(() => {
      hoverFrame = undefined;
      const position = hoverPosition;
      hoverPosition = undefined;
      if (position) layerHover(position);
    });
  }

  /**
   * Resolves the latest pointer position against cached alpha pixels and marks
   * the frontmost visible layer as hovered. Called once per requested frame.
   */
  function layerHover(event: { clientX: number; clientY: number }) {
    // Resolve hover from rendered alpha pixels rather than rectangular image
    // bounds, while ignoring layers currently hidden by the fold state.
    // Use the cached front-to-back order.
    if (!clickStack) return;
    // Ignore hidden layers before sampling their image alpha.
    const hovered = frontToBackLayers.find((layer) => {
      if (layer.classList.contains('is-obscured') || getComputedStyle(layer).opacity === '0') return false;
      return hitsLayer(layer, event.clientX, event.clientY, 24);
    });
    // Clear the previous hover state before applying the new one.
    if (hoveredLayer === hovered) return;
    if (hoveredLayer) {
      hoveredLayer.classList.remove('is-hovered');
      hoveredLayer.style.cursor = 'default';
    }
    hoveredLayer = hovered;
    clickStack.style.cursor = hovered ? 'pointer' : 'default';
    if (hovered) {
      hovered.classList.add('is-hovered');
      hovered.style.cursor = 'pointer';
    }
  }

  /**
   * Removes the temporary hover state from every layer.
   * Called when the pointer leaves the stack.
   */
  function clearLayerHover() {
    if (hoverFrame !== undefined) {
      window.cancelAnimationFrame(hoverFrame);
      hoverFrame = undefined;
    }
    hoverPosition = undefined;
    if (!clickStack) return;
    clickStack.style.cursor = 'default';
    if (hoveredLayer) {
      hoveredLayer.classList.remove('is-hovered');
      hoveredLayer.style.cursor = 'default';
      hoveredLayer = undefined;
    }
  }

  // Centralized listener registration: these bindings define when each
  // interaction function above is called and keep layer state changes here.
  clickStack?.addEventListener('click', stackFolding);
  clickStack?.addEventListener('dblclick', (event) => event.preventDefault());
  structure?.querySelectorAll<HTMLAnchorElement>('.chapter-marker__link').forEach((link) => {
    link.addEventListener('click', chapterLabelClick);
  });
  document?.addEventListener('click', stackUnfolding);
  clickStack?.addEventListener('pointermove', scheduleLayerHover);
  clickStack?.addEventListener('pointerleave', clearLayerHover);

</script>
