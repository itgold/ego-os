---
import { homepage } from '../../data/homepage';
---

<header class="ego-title" id="about">
  <h1>{homepage.title}</h1>
  <p class="ego-title__subtitle">{homepage.subtitle}</p>
  <div class="ego-title__introduction">
    <h2>{homepage.heading}</h2>
    <p class="ego-title__description">{homepage.introduction}</p>
    <a class="ego-title__begin" href={homepage.readingLink.href}>
      <span>{homepage.readingLink.label}</span>
      <svg viewBox="0 0 24 16" width="24" height="16" fill="none" aria-hidden="true">
        <path d="M1 8h21M16 2l6 6-6 6" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </a>
  </div>
</header>
