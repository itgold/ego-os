---
import type { BookPart } from '../../../data/bookParts';
import { Image } from 'astro:assets';

interface Props {
  part: BookPart;
  index: number;
}

const { part, index } = Astro.props;
const style = `--part-index: ${index}; --part-color: ${part.color}; --label-y: ${part.labelY}; --part-mask: url('${part.mask}')`;
const stackAsset = part.asset.replace('-texture-stack.png', '-texture.png');
---

<article
  class:list={['part-layer', { 'part-layer--active': part.defaultLayer }]}
  id={part.id}
  data-part={part.id}
  style={style}
  aria-current={part.defaultLayer ? 'page' : undefined}
>
  <div class="part-layer__surface" id={part.defaultLayer ? 'active-part-surface' : undefined}>
    <svg class="part-layer__alpha-shadow" viewBox="0 0 1163 853" aria-hidden="true">
      <image href={`/assets/shadows/layer-${part.id.replace('part-', '')}-shadow.png`} x="-80" y="-80" width="1323" height="1013" />
    </svg>
    <div class="part-layer__content">
      <Image
        class="part-layer__texture"
        src={part.asset}
        width="1163"
        height="853"
        alt=""
        loading="eager"
      />
      {part.id === 'part-02' && <img class="part-layer__particle-grid" src="/assets/overlays/layer-02-particle-grid.svg" width="1163" height="853" alt="" aria-hidden="true" />}
      {part.id === 'part-03' && <img class="part-layer__particle-grid" src="/assets/overlays/layer-03-particles.svg" width="1163" height="853" alt="" aria-hidden="true" />}
      {part.id === 'part-04' && <img class="part-layer__particle-grid" src="/assets/overlays/layer-04-particle-grid.svg" width="1163" height="853" alt="" aria-hidden="true" />}
      {part.id === 'part-05' && <img class="part-layer__particle-grid part-layer__resource-stream" src="/assets/overlays/layer-05-resource-stream.svg" width="1163" height="853" alt="" aria-hidden="true" />}
      {part.id === 'part-06' && <img class="part-layer__particle-grid" src="/assets/overlays/layer-06-orbital-particles.svg" width="1163" height="853" alt="" aria-hidden="true" />}
      {part.id === 'part-07' && <img class="part-layer__particle-grid" src="/assets/overlays/layer-07-firefly-particles.svg" width="1163" height="853" alt="" aria-hidden="true" />}
      {part.id === 'part-08' && <img class="part-layer__particle-grid" src="/assets/overlays/layer-08-cosmic-particles.svg" width="1163" height="853" alt="" aria-hidden="true" />}
      {part.id !== 'part-01' && (
        <Image class="part-layer__stack-texture" src={stackAsset} width={1163} height={853} alt="" aria-hidden="true" loading="eager" />
      )}
      <slot />
    </div>
  </div>
  <button class="part-layer__hit" type="button" aria-label={`Toggle ${part.number} ${part.title}`}></button>
  <a class="part-layer__label" href={part.href} aria-label={`${part.number}${part.title ? ` ${part.title}` : ''}`}>
    <span class="part-layer__rule" aria-hidden="true"></span>
    <span class="part-layer__number">{part.number}<span class="part-layer__separator" aria-hidden="true"> — </span></span>
    <span class="part-layer__title">{part.title}</span>
  </a>
</article>
