---
import type { CollectionEntry } from 'astro:content';

interface Props {
  chapters: CollectionEntry<'chapters'>[];
}

const { chapters } = Astro.props;
---

<nav class="table-of-contents" aria-labelledby="contents-heading">
  <h2 id="contents-heading">Table of contents</h2>
  <ol>
    {chapters.map((chapter) => (
      <li>
        <a href={`/chapters/${chapter.slug}/`}>
          <span class="table-of-contents__number">{String(chapter.data.chapterNumber).padStart(2, '0')}</span>
          <span>{chapter.data.title}</span>
        </a>
      </li>
    ))}
  </ol>
</nav>
